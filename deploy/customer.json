{
  "task_id": "customer-task",
  "tenant_id": "customer",
  "policy": {
    "agents": [
      "main"
    ],
    "stage": "deployment",
    "answer_mode": "model",
    "local_only": false,
    "max_requests": 1000,
    "max_read_requests": 2000,
    "max_denials": 20,
    "approval_ttl_seconds": 300,
    "tool_grants": {
      "python_docs": {
        "approval": "standing",
        "max_calls": 40,
        "allow_argument_egress": true
      },
      "compute": {
        "approval": "standing",
        "max_calls": 40
      }
    }
  },
  "sources": [],
  "tools": [
    {
      "id": "python_docs",
      "kind": "http_read",
      "origin": "https://docs.python.org",
      "path_prefix": "/3",
      "query_keys": [],
      "timeout_seconds": 10,
      "max_response_bytes": 65536
    },
    {
      "id": "compute",
      "kind": "linux_sandbox",
      "rootfs": "/opt/aeg/rootfs",
      "timeout_seconds": 5,
      "memory_bytes": 134217728,
      "process_limit": 16,
      "max_output_bytes": 65536
    }
  ]
}
